# =====================================================================
# AI COO Data Acquisition Configuration
# =====================================================================

# Optional Residential / Datacenter Proxy Configuration
# Format: http://user:password@proxy_host:proxy_port
HTTP_PROXY=
HTTPS_PROXY=

# Web Scraping API Proxy Service (e.g. ScraperAPI, BrightData, ZenRows)
# Example: http://scraperapi:YOUR_KEY@proxy-server.scraperapi.com:8001
SCRAPER_API_KEY=

# Target Market Regional Settings
DEFAULT_TARGET_COUNTRY=US
DEFAULT_CURRENCY=USD

# Rate Limiting & Delays (Seconds)
SCRAPER_MIN_DELAY=2.0
SCRAPER_MAX_DELAY=4.5
